RUST_LOG="info"

# --- Network ---
HOST="127.0.0.1"
PORT=3000
PUBLIC_HTTP_URL="http://localhost:3000"
PUBLIC_WS_URL="ws://localhost:3000"
CORS_ALLOWED_ORIGINS="*"

# --- Database ---
DATABASE_URL="mysql://user:password@localhost/rigel"
DB_MAX_CONNECTIONS=16

# --- Authentication ---
AUTH_SECRET="replace_with_a_secure_random_secret"
AUTH_LOGIN_MODE="username"
AUTH_TAG_STYLE="none"
AUTH_REGISTRATION_MODE="open"

# --- Instance Branding ---
INSTANCE_NAME="Rigel"
INSTANCE_DESCRIPTION="A self-hosted Rigel server"
INSTANCE_IMAGE=""
INSTANCE_COLOR="#000000"
INSTANCE_COUNTRY_CODE="FR"
INSTANCE_CONTACT_EMAIL=""
INSTANCE_OWNER_ID=""
INSTANCE_WEBSITE_URL=""
INSTANCE_TERMS_URL=""
INSTANCE_PRIVACY_URL=""
INSTANCE_GUIDELINES_URL=""
INSTANCE_WEBAPP_URL=""

# --- Features ---
GUILD_CREATION_POLICY="staff"
ENABLE_ATTACHMENTS=false
ENABLE_AUTO_EMOJI_SYNC=true